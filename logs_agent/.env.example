# Copy to .env and fill in values. Do not commit .env.

# ---------------------------------------------------------------------------
# Backend selection
#   local  — LocalLogConnector (reads data/ad_service.log)
#   azure  — AzureLogAnalyticsConnector (OTelLogs in Log Analytics)
# Unset or blank also defaults to local.
# ---------------------------------------------------------------------------
LOG_CONNECTOR=azure

# ---------------------------------------------------------------------------
# Azure Log Analytics (required when LOG_CONNECTOR=azure)
# ---------------------------------------------------------------------------
AZURE_LOG_ANALYTICS_WORKSPACE_ID=

# Authentication uses DefaultAzureCredential (no secrets in this repo).
# Local development: typically Azure CLI (`az login`).
# Production: the same code path with a managed identity that can query
# the target Log Analytics workspace.

# ---------------------------------------------------------------------------
# Azure AI Foundry (required to call investigate_logs)
# ---------------------------------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=

# Deployment name for the Logs Agent. Recommended production value:
FOUNDRY_MODEL=gpt-4.1-mini

# Optional fallback if FOUNDRY_MODEL is unset (legacy).
# MODEL_DEPLOYMENT_NAME=

# Optional: print per-step tool traces in the CLI (default: on).
# DEBUG_TOOL_CALLS=1

# ---------------------------------------------------------------------------
# Orchestrator HTTP adapter (optional)
# The orchestrator sets LOGS_AGENT_URL to this service's complete POST URL.
# Do not put the orchestrator URL or Azure secrets here.
# ---------------------------------------------------------------------------
# Shared bearer token. If set, the service requires:
#   Authorization: Bearer <same value>
# Configure the same value as LOGS_AGENT_TOKEN on the orchestrator.
# LOGS_AGENT_TOKEN=

# Bind address for `python orchestrator_service.py`
# LOGS_AGENT_HOST=127.0.0.1
# LOGS_AGENT_PORT=8101
