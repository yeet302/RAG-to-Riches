# Copy to code_agent/.env and fill in. Never commit .env. Check with: python orchestrator/check_setup.py --deep
# These three are required. If any is missing the agent answers "Code Agent is not configured"
# (CODE_NOT_CONFIGURED) on the first question, even though its /health check passes.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net/

# Optional (these are the defaults).
AZURE_SEARCH_INDEX=rag-to-riches-code
FOUNDRY_CODE_AGENT_NAME=rag-to-riches-code-agent

# The only repository the code agent may read (code_agent/config.py). Any other value is refused.
CODE_REPO=yeet302/RAG-to-Riches
# The commit the search index was built from. 4a70112... = the five Ad Service planted bugs (B-01..B-05).
# If the index is rebuilt for another commit (e.g. a newer planted bug), use that SHA. Ask Navya.
CODE_REF=4a701124503f86431f52a000c01d2d73322d39e0

# Optional: a read-only GitHub token avoids GitHub API rate limits. Keep it only in .env.
GITHUB_TOKEN=

# Optional: if set, the orchestrator must send the same value as CODE_AGENT_TOKEN.
# CODE_AGENT_TOKEN=
