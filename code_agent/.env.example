# Copy to code_agent/.env and fill in. Do not commit .env.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
FOUNDRY_CODE_AGENT_NAME=rag-to-riches-code-agent
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net/
AZURE_SEARCH_INDEX=rag-to-riches-code
CODE_REPO=open-telemetry/opentelemetry-demo
# The commit the search index was built from (search results are filtered to this commit).
CODE_REF=

# ---------------------------------------------------------------------------
# Security (SECURITY_SETUP.md at the repository root)
# With KEY_VAULT_URL set, GITHUB_TOKEN and CODE_AGENT_TOKEN are read from Key Vault with your
# Azure sign-in (or this service's managed identity in Azure), and must NOT appear in this file.
# Without Key Vault (local only): GITHUB_TOKEN=github_pat_... and CODE_AGENT_TOKEN=...
# KEY_VAULT_URL=https://YOUR-VAULT.vault.azure.net/
# REQUIRE_AGENT_AUTH=true      # refuse to start without CODE_AGENT_TOKEN
