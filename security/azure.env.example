# Copy to security/azure.env (git-ignored) and fill in. These are resource names/IDs, not secrets.
# Find a resource ID: Azure portal -> the resource -> Overview -> "JSON View" -> Resource ID,
# or: az resource list --query "[].{name:name, id:id}" -o table

SUBSCRIPTION_ID=
RESOURCE_GROUP=rg-rag-to-riches
LOCATION=eastus2
# 3-24 letters/digits/hyphens, globally unique, e.g. kv-rag2riches-team2
KEY_VAULT_NAME=

# What each agent needs to reach (leave blank to skip; the script prints who must run that part).
# Orchestrator's model: the AI Services resource behind orchestrator AZURE_AI_ENDPOINT (e.g. jwoo32-6683-resource)
ORCHESTRATOR_MODEL_RESOURCE_ID=
# Docs agent's model: the resource behind docs_agent AZURE_AI_ENDPOINT
DOCS_MODEL_RESOURCE_ID=
# Code agent: the Foundry resource of FOUNDRY_PROJECT_ENDPOINT (e.g. pangarkar-code-agent) and the Search service
CODE_FOUNDRY_RESOURCE_ID=
CODE_SEARCH_RESOURCE_ID=
# Logs agent: the Foundry resource of its FOUNDRY_PROJECT_ENDPOINT and the Log Analytics workspace
LOGS_FOUNDRY_RESOURCE_ID=
LOGS_WORKSPACE_RESOURCE_ID=

# Teammates who run the services on their laptops (Entra sign-in names), space-separated.
# They get read access to the secrets so `python orchestrator/run_local.py` works for them.
TEAM_MEMBERS=
