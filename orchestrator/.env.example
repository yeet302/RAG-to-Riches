# These are environment variables; this application does not auto-load .env files.
# Export the desired values in your shell before starting Python/uvicorn.
ORCHESTRATOR_MODE=local
AGENT_TIMEOUT_SECONDS=20
# DOCS_ROOT=/absolute/path/to/runbooks
# CODE_ROOT=/absolute/path/to/application/repository
# LOGS_ROOT=/absolute/path/to/captured/logs

# Each URL is the full POST endpoint, not a base URL. Any configured URL takes
# precedence over local search. Remote mode disables fallback to local files.
# ORCHESTRATOR_MODE=remote
# LOGS_AGENT_URL=http://127.0.0.1:8100/agents/logs/run
# DOCS_AGENT_URL=http://127.0.0.1:8100/agents/docs/run
# CODE_AGENT_URL=http://127.0.0.1:8100/agents/code/run
# LOGS_AGENT_TOKEN=replace-with-service-token
# DOCS_AGENT_TOKEN=replace-with-service-token
# CODE_AGENT_TOKEN=replace-with-service-token

# Old canned scenarios are available only with ORCHESTRATOR_MODE=demo.
