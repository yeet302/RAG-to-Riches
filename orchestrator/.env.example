# These are environment variables; this application does not auto-load .env files.
# Export the desired values in your shell before starting Python/uvicorn.
ORCHESTRATOR_MODE=remote
AGENT_TIMEOUT_SECONDS=60
# Logs can require several model/tool steps; both HTTP and total deadlines use this.
LOGS_AGENT_TIMEOUT_SECONDS=180
# DOCS_AGENT_TIMEOUT_SECONDS=60
# CODE_AGENT_TIMEOUT_SECONDS=60
# DOCS_ROOT=/absolute/path/to/runbooks
# CODE_ROOT=/absolute/path/to/application/repository
# LOGS_ROOT=/absolute/path/to/captured/logs

# Each URL is the full POST endpoint, not a base URL. Any configured URL takes
# precedence over local search. Remote mode disables fallback to local files.
# ORCHESTRATOR_MODE=remote
# LOGS_AGENT_URL=http://127.0.0.1:8101/agents/logs/run
# DOCS_AGENT_URL=http://127.0.0.1:8102/agents/docs/run
# CODE_AGENT_URL=http://127.0.0.1:8103/agents/code/run
# LOGS_AGENT_TOKEN=replace-with-service-token
# DOCS_AGENT_TOKEN=replace-with-service-token
# CODE_AGENT_TOKEN=replace-with-service-token

# Prepared answers are disabled. Missing remote agents report unavailable.
# Set ORCHESTRATOR_MODE=local only for explicit offline corpus retrieval.

# Azure plans specialist assignments when configured; otherwise keywords are used.
ROUTING_MODE=auto
# AZURE_AI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
# A full /openai/v1/responses URL is also supported.
# AZURE_AI_MODEL=YOUR-DEPLOYMENT-NAME
# AZURE_AI_DEPLOYMENT is also accepted as a legacy alias when MODEL is unset.
# AZURE_AI_API_KEY=YOUR-KEY
AZURE_AI_API_STYLE=openai_v1
LLM_TIMEOUT_SECONDS=10
# AZURE_AI_API_VERSION=
# For an existing /models inference endpoint, set AZURE_AI_API_STYLE=inference.
# Its default API version is 2024-05-01-preview.

# Final answers are AI-generated by default when Azure is configured.
# This setting is independent of ROUTING_MODE.
ANSWER_MODE=auto
SYNTHESIS_TIMEOUT_SECONDS=30
# ANSWER_MODE=evidence disables AI answer generation.

# Use your Azure sign-in instead of a model API key.
# AZURE_AI_AUTH_MODE=entra
# Requires az login in the same environment and model resource permissions.
