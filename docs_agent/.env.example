# No credentials are required for offline tests. Configure these for real answers.
AZURE_AI_ENDPOINT=
AZURE_AI_MODEL=
AZURE_AI_API_KEY=
AZURE_AI_API_STYLE=openai_v1
AZURE_AI_API_VERSION=
DOCS_AGENT_TOKEN=
DOCS_TIMEOUT_SECONDS=18
DOCS_FETCH_TIMEOUT_SECONDS=5
LLM_TIMEOUT_SECONDS=10
DOCS_REPO=open-telemetry/opentelemetry-demo
DOCS_REF=main
DOCS_PATHS=README.md,src/ad/README.md

# Dynamic discovery; DOCS_PATHS are optional extra seed files.
DOCS_GITHUB_ROOTS=src/ad
DOCS_WEBSITE_SEEDS=https://opentelemetry.io/docs/demo/
DOCS_MAX_WEB_PAGES=16
DOCS_MAX_GITHUB_DOCS=20
DOCS_DISCOVERY_TIMEOUT_SECONDS=7

# Use your Azure sign-in instead of a model API key.
# AZURE_AI_AUTH_MODE=entra
# Requires az login in the same environment and model resource permissions.
